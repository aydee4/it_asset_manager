# Required: generate a strong random value for each environment.
SECRET_KEY=

# Optional: defaults to sqlite:///assets.db for local development.
DATABASE_URL=sqlite:///assets.db

# Optional: keep disabled in production.
FLASK_DEBUG=0

# Optional: set to 1 when the app is served over HTTPS in production.
SESSION_COOKIE_SECURE=0

# Optional: login throttling settings.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Optional: used by Docker and some hosting platforms.
PORT=8000
